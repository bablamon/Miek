{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Miek",
  "version": "0.4.0",
  "identifier": "dev.miek.player",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Miek",
        "width": 1240,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "windowEffects": {
          "effects": [
            "acrylic"
          ]
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://archive.org https://*.archive.org data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/Miek/covers/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRTdCQ0IxNzcyM0YyQUUKUldTdThpTjNzYnpuMFN4b3NiY3M5Y0JxYWhGVVpvZkJMbS8wNXVtZnFJTDBjRHZIV3hXbWtFRlMK",
      "endpoints": ["https://github.com/bablamon/Miek/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Miek",
    "shortDescription": "Lossless music player",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}